+def _required_height(
+    items: list[tuple[str, bool]],
+    px: int,
+    box_w: int,
+    margin_boxes: int,
+    indent_em: float = 0,
+) -> int:
+    units = _split_units(items)
+    lines = sum(
+        max(1, len(_wrap_lines(unit, px, box_w - math.ceil(px * indent_em))[0]))
+        for unit in units
+    )
+    return lines * _line_box(px) + max(0, margin_boxes) * BLOCK_MARGIN_Y
