+def _text_fits(
+    items: list[tuple[str, bool]],
+    px: int,
+    box_w: int,
+    box_h: int,
+    *,
+    margin_boxes: int = 1,
+    indent_em: float = 0,
+) -> bool:
+    ok, _ = _text_fits_detail(
+        items, px, box_w, box_h, margin_boxes=margin_boxes, indent_em=indent_em
+    )
+    return ok
