+    box_h = sp._box_h
+    need_h = 0
+    for text_c, role_key in sp._cover_items:
+        px = sp.role_sizes[role_key]
+        strong = role_key == "title"
+        lines, wo = _wrap_lines([(text_c, strong)], px, box_w)
+        if wo:
+            return False
+        need_h += max(1, len(lines)) * _line_box(px) + BLOCK_MARGIN_Y
