+                        action="measure",
+                        result="accepted",
+                        slide_number=m.slide_number,
+                        layout_type=m.layout_type,
+                        surface_id=m.surface_id,
+                        expected=f"{fit} synchronized to {target}px",
+                        input_meta={"type": "int", "value": target},
+                    )
+                )
