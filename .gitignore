# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Test / tooling caches
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Preprocessor runtime outputs (regenerated per run — don't commit)
output/
out_*/
*_output/
run.log

# Amex/sim fidelity runs live in GNHF worktrees only (large PNG evidence; do not bloat main)
simulation/

# Treehouse worktree-pool config: defaults only (max_trees/root), so it is not worth
# tracking. Pool location is set by the TREEHOUSE_DIR env var, not by this file.
treehouse.toml

# Per-ticket delegation briefs handed to worker agents in treehouse worktrees.
# They are scratch instructions, not repo docs.
TASK_*.md
Impact_Slides-*/

# Disposable local/CI scratch (do not commit)
.tmp/
